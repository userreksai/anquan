[Unit]
Description=Anqu file and login audit
After=local-fs.target

[Service]
Type=oneshot
User=root
UMask=0022
ExecStart=/usr/local/anqu/anqu
# Reduce accidental core dumps; this does not prevent root from inspecting memory.
LimitCORE=0
# 2 means collection succeeded but changes/missing files were found.
SuccessExitStatus=2
NoNewPrivileges=true
PrivateTmp=true
