[Unit]
Description=Anqu continuous security monitoring agent
After=local-fs.target network.target
Conflicts=anqu-oneshot.service agent.service

[Service]
Type=simple
User=root
UMask=0022
EnvironmentFile=-/etc/anqu-agent.env
ExecStart=/usr/local/anquan/anquan -service
Restart=on-failure
RestartSec=5
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
