{
  "output_dir": "/usr/local/anqu",
  "state_file": "state/md5.json",
  "timezone": "Asia/Shanghai",
  "md5": {
    "enabled": true,
    "paths": ["/etc/ssh", "/etc/crontab"],
    "recursive": true,
    "exclude_paths": ["/etc/ssh/ssh_config.d/cache"]
  },
  "login": {
    "enabled": true,
    "source": "wtmp",
    "path": "/var/log/wtmp",
    "last_command": "last",
    "timeout_seconds": 10,
    "max_records": 1000
  },
  "existence": {
    "enabled": true,
    "list_file": "files.json",
    "base_dir": "/etc"
  }
}
